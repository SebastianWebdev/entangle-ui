{
  "name": "entangle-ui",
  "version": "0.13.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.css.ts",
    "*.css.js"
  ],
  "description": "A specialized React component library for building professional editor interfaces",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./styles.css": "./dist/esm/styles.css.js",
    "./palettes": {
      "types": "./dist/types/palettes.d.ts",
      "default": "./dist/esm/palettes.js"
    },
    "./theme": {
      "types": "./dist/types/theme/index.d.ts",
      "default": "./dist/esm/theme/index.js"
    },
    "./theme-values": {
      "types": "./dist/types/theme-values.d.ts",
      "default": "./dist/esm/theme-values.js"
    },
    "./tokens.json": "./dist/tokens/tokens.json",
    "./tokens.dark.css": "./dist/tokens/tokens.dark.css",
    "./tokens.light.css": "./dist/tokens/tokens.light.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run --prefix docs-site dev",
    "build": "rollup -c && npm run build:tokens",
    "build:tokens": "tsx scripts/export-tokens.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:failed": "vitest run --reporter=./scripts/failed-tests-reporter.js",
    "test:coverage": "vitest run --coverage",
    "test:package-report": "npm run test:coverage && node scripts/generate-package-report.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "check:browser-safe": "tsx scripts/check-browser-safe.ts",
    "check:sourcemaps": "tsx scripts/check-sourcemaps.ts",
    "prepublishOnly": "npm run clean && npm run build && npm run check:browser-safe && npm run check:sourcemaps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write --cache --ignore-unknown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "size": "size-limit",
    "docs:dev": "npm run --prefix docs-site dev",
    "docs:build": "npm run --prefix docs-site build",
    "docs:preview": "npm run --prefix docs-site preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,mdx,css,html,yaml,yml}": [
      "prettier --write --cache --ignore-unknown"
    ]
  },
  "keywords": [
    "react",
    "typescript",
    "ui-library",
    "editor",
    "components",
    "ui-toolkit",
    "design-system",
    "react-components",
    "editor-ui"
  ],
  "author": "Sebastian Gołębiowski <see.golebiowski@gmail.com>",
  "license": "MIT",
  "homepage": "https://www.entangle-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianWebdev/entangle-ui.git"
  },
  "bugs": {
    "url": "https://github.com/SebastianWebdev/entangle-ui/issues"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.1.0",
    "@floating-ui/react": "^0.27.17",
    "@tanstack/react-virtual": "^3.13.0",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/rollup-plugin": "^1.5.1",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.6.7",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "size-limit": "^12.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {}
}
